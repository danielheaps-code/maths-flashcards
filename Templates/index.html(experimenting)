    <div class="folder-panel" id="categoryScreen" style="display: none;">
        <h2 id="selectedTopic"></h2>
        <p>Choose what you want to study:</p>
        <div class="folder-grid">
            <div class="folder" onclick="chooseCategory('definitions')">
                📁 Definitions<br><small>Terms and concepts</small>
            </div>
            <div class="folder" onclick="chooseCategory('results')">
                📁 Results<br><small>Lemmas, propositions and theorems</small>
            </div>
        </div>
        <div class="toolbar">
            <button onclick="backToTopics()">← Back to folders</button>
